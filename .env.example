# Copy to .env and fill in. Never commit .env.

# "mock" runs fully offline; "gemini" uses Google Gemini.
LLM_PROVIDER=gemini

# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option B: Vertex AI on Google Cloud (uses Application Default Credentials)
USE_VERTEX_AI=false
GCP_PROJECT=
GCP_LOCATION=us-central1

CHAT_MODEL=gemini-3.6-flash
# Seconds before a Gemini call is abandoned, and how many times to retry transient errors.
THINKING_LEVEL=low
LLM_TIMEOUT_S=60
LLM_RETRIES=3
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# USD per 1M tokens, used for cost-per-request metrics. Check current pricing.
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

# local (NumPy, persistent) or chroma (pip install chromadb)
VECTOR_BACKEND=local
DATA_DIR=.data
TOP_K=5
MAX_REVISIONS=2

# Required in production: clients must send it as the X-API-Key header.
API_KEY=
